{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/template/assets/(css|js)/(.*)",
      "dest": "/public/template/assets/$1/$2",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/template/(.*)",
      "dest": "/public/template/$1"
    },
    {
      "src": "/favicon.(ico|png|svg)",
      "dest": "/public/favicon.$1"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
