#--------------------------------------------------------------------
# APLIKASI AKUNTANSI BERBASIS WEB (AABW) - CODEIGNITER 4
# CONFIG PRODUCTION UNTUK HOSTING / CPANEL (VIDEO #20)
#--------------------------------------------------------------------

# 1. Mode Environment (production menyembunyikan error debugbar)
CI_ENVIRONMENT = production

# 2. Base URL Hosting (Ganti dengan domain atau subdomain Anda di hosting)
# Contoh: https://akuntansi.domainanda.com/ atau https://domainanda.com/
app.baseURL = 'https://nama-domain-anda.com/'

# 3. Konfigurasi Database Hosting
# Buat database dan user database baru di cPanel MySQL Database Wizard
# Kemudian masukkan nama database, user, dan password di bawah ini:
database.default.hostname = localhost
database.default.database = cpaneluser_aabw
database.default.username = cpaneluser_dbuser
database.default.password = PasswordHostingAnda123!
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

# 4. Keamanan Session
# app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
# app.sessionCookieName = 'ci_session'
# app.sessionExpiration = 7200
